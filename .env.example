# Credenciais do backend (Supabase). Copie para um arquivo .env e preencha.
# Encontre estes valores em: Supabase → Project Settings → API
# (a "anon public key" pode ficar exposta no frontend — é o padrão do Supabase)
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-public-key

# Cloudflare R2 (upload de vídeo). SEM prefixo VITE_ de propósito — usadas só
# em /api (servidor), nunca no navegador. Ver SETUP.md seção 8.
R2_ACCOUNT_ID=seu-account-id
R2_ACCESS_KEY_ID=sua-access-key-id
R2_SECRET_ACCESS_KEY=sua-secret-access-key
R2_ENDPOINT=https://SEU_ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=geosense-videos
R2_PUBLIC_URL=https://pub-xxxx.r2.dev
