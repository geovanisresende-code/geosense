# Credenciais do backend (Supabase). Copie para um arquivo .env e preencha.
# Encontre estes valores em: Supabase → Project Settings → API
# (a "anon public key" pode ficar exposta no frontend — é o padrão do Supabase)
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-public-key

# Cloudflare R2 (upload de vídeo). SEM prefixo VITE_ de propósito — usadas só
# em /api (servidor), nunca no navegador. Ver SETUP.md seção 8.
R2_ACCOUNT_ID=seu-account-id
R2_ACCESS_KEY_ID=sua-access-key-id
R2_SECRET_ACCESS_KEY=sua-secret-access-key
R2_ENDPOINT=https://SEU_ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=geosense-videos
R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# Shopify OAuth — Partner Dashboard → App → Client ID / Client secret.
# SEM prefixo VITE_ de propósito: usadas só em /api/auth/*, nunca no navegador.
SHOPIFY_API_KEY=seu-client-id
SHOPIFY_API_SECRET=shpss_seu-client-secret
SHOPIFY_STORE_DOMAIN=sualoja.myshopify.com
SHOPIFY_SCOPES=read_products,write_products
APP_URL=https://seu-app.vercel.app

# Versão da Admin API usada em /api/sync-products e /api/shopify-product.
SHOPIFY_API_VERSION=2026-07

# Segredo com que a Shopify assina os webhooks. Fica em:
# Shopify Admin → Configurações → Notificações → Webhooks ("assinados com:").
# NUNCA comite o valor real — coloque só nas Environment Variables da Vercel.
SHOPIFY_WEBHOOK_SECRET=cole-o-segredo-dos-webhooks-aqui

# Opcional: token fixo de "custom app" criado direto no admin da loja, para
# quem não quer passar pelo fluxo de OAuth.
# SHOPIFY_ADMIN_TOKEN=shpat_...

# Domínio da loja usado só para montar o link "Ver na loja" no painel.
# Este tem prefixo VITE_ de propósito: é um domínio público, não um segredo.
VITE_SHOPIFY_STORE_DOMAIN=sualoja.myshopify.com

# Chave de service role do Supabase (Project Settings → API → service_role).
# Usada por /api/auth/callback, /api/sync-products e pelo webhook. É uma chave
# que ignora RLS: SEM prefixo VITE_, jamais no navegador.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key
